# Copia este archivo como .env.local (o ejecuta `npm run vercel:pull` para
# generarlo automáticamente con los valores reales de tu proyecto en Vercel).

# ─── Supabase (cliente) ───────────────────────────────────
# Estas se inyectan en el bundle del frontend vía src/environments/*.ts
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# ─── DeepSeek (servidor — Vercel Functions) ───────────────
# Solo se usa en /api/*. Nunca se expone al frontend.
DEEPSEEK_API_KEY=TU_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
